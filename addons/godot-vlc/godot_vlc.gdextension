[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
android.debug.arm64 = "bin/android-arm64/libgodot_vlc.so"
android.release.arm64 = "bin/android-arm64/libgodot_vlc.so"

[dependencies]
android.arm64 = {
    "res://addons/godot-vlc/bin/android-arm64/libgodot_vlc.so": "",
    "res://addons/godot-vlc/bin/android-arm64/libvlc.so": ""
}

[icons]
VLCMedia = "res://addons/godot-vlc/icons/VLCMedia.svg"
VLCMediaPlayer = "res://addons/godot-vlc/icons/VLCMediaPlayer.svg"
