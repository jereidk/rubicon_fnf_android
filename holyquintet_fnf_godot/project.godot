; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that change here are also mirrored in the
; project.godot.tres resource file.

config_version=5

[application]

config/name="HolyQuintet FNF - Godot Port"
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas"

[debug]

gdscript/warnings/unused_variable=1
