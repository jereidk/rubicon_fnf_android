+int Image::get_format_bytes_per_block(Format p_format) {
+	switch (p_format) {
+		// ASTC always stores exactly 16 bytes/block regardless of block
+		// footprint (part of the format spec) - true for every ASTC format,
+		// but spelled out explicitly here (rather than falling into the
+		// general case below) since it's the reason these three block sizes
+		// can share one code path with 4x4/8x8 despite not being expressible
+		// as a power-of-two pixel_rshift.
+		case FORMAT_ASTC_4x4:
+		case FORMAT_ASTC_4x4_HDR:
+		case FORMAT_ASTC_8x8:
+		case FORMAT_ASTC_8x8_HDR:
+		case FORMAT_ASTC_10x10:
+		case FORMAT_ASTC_10x10_HDR:
+		case FORMAT_ASTC_12x12:
+		case FORMAT_ASTC_12x12_HDR: {
+			return 16;
+		}
+		default: {
+			// Every other compressed format's byte-per-block count is fully
+			// determined by its existing (block_size, pixel_size, pixel_rshift)
+			// triple - derive it instead of re-stating it a third time, so this
+			// is provably identical to the pre-existing pixsize>>rshift result
+			// for every format that isn't one of the three above.
+			int block = get_format_block_size(p_format);
+			int pixel_size = get_format_pixel_size(p_format);
+			int pixel_rshift = get_format_pixel_rshift(p_format);
+			return (block * block * pixel_size) >> pixel_rshift;
+		}
+	}
