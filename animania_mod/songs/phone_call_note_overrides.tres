; Note database for phone-call.
;
; Two of the chart's 362 notes carry the V-Slice note kind "noAnimation" - the holds at
; 80156.25ms and 86472.04ms, both on the player side. Rubicon builds a note's database key
; as "<type>_<mode>", so those two ask for "noAnimation_mania", and with no such key the
; handler indexes a Dictionary that does not have it. That is not a one-off: the lookup
; happens per frame while the note is alive, so the full-song run threw 911 errors off
; those two notes alone. The pool prewarm at rubicon_level_note_handler.gd:262 guards with
; has(), but the two paths that matter (:384 and :515) do not.
;
; So they get an entry, drawn with the same Funkin note as everything else.
;
; What this does NOT do is the half the kind is named for. In V-Slice "noAnimation" means
; the note is hit but the character does not sing, and Rubicon decides the sing animation
; from the LANE (rubicon_character.gd's mania_anim_aliases), never from the note type -
; there is no flag on RubiconLevelNoteMetadata to suppress it and no seam to hook without
; editing vendored engine code. Both notes land within 25ms of the two PlayAnimation
; events that put komi into "breath", which is presumably why the charter marked them.
; Until a character-side hook exists, tadano sings through them.
[gd_resource type="Resource" script_class="RubiconLevelNoteDatabase" format=3]

[ext_resource type="Script" path="res://addons/rubicon/scripts/data/game/rubicon_level_note_metadata.gd" id="1_meta"]
[ext_resource type="Script" path="res://addons/rubicon/scripts/data/game/rubicon_level_note_database.gd" id="2_db"]
[ext_resource type="PackedScene" path="res://resources/levels/ui/funkin/mania/Note.tscn" id="3_note"]

[sub_resource type="Resource" id="Resource_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_noanim"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[resource]
script = ExtResource("2_db")
defines = Dictionary[StringName, ExtResource("1_meta")]({
&"mania": SubResource("Resource_mania"),
&"noAnimation_mania": SubResource("Resource_noanim")
})
