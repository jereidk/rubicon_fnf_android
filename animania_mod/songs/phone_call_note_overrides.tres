; Base de notas de TODAS las canciones del puerto.
;
; El nombre del fichero dice phone_call por historia: nacio con la unica clase de nota que
; tenia phone-call y las cinco escenas de cancion lo comparten. Se queda donde esta porque
; renombrarlo obliga a tocar esas cinco escenas y el builder; el nombre miente, esto no.
;
; Rubicon arma la clave de una nota como "<tipo>_<modo>", asi que una nota con clase
; `beatbox` en mania pide "beatbox_mania". Sin esa clave el manejador INDEXA un Dictionary
; que no la tiene, y no es un fallo de una vez: la busqueda ocurre por fotograma mientras
; la nota vive. En un movil real, una vuelta a `fresh` saco 4175 errores de
; rubicon_level_note_handler.gd:384 y 27 de :515. El prewarm del pool en :262 se protege
; con has(); esas dos rutas no.
;
; Las clases que usan las canciones porteadas, sacadas de sus propios charts:
;
;   bopeebo      Fuck Up, blush, cheer, mom, noAnimation, solotime, stop bope
;   dadbattle    blush, fresh, mom, noAnimation, solotime
;   fresh        Fuck Up, beatbox, blush, erect-up, fresh, mom, noAnimation, solotime
;   phone-call   noAnimation
;   tutorial     (ninguna)
;
; Todas se dibujan con la misma nota de Funkin, porque en V-Slice una clase de nota es una
; etiqueta de COMPORTAMIENTO, no un grafico distinto.
;
; Lo que esto NO hace es la mitad por la que algunas se llaman como se llaman. En V-Slice
; "noAnimation" significa que la nota se toca y el personaje NO canta, y Rubicon decide la
; animacion de canto por el CARRIL -mania_anim_aliases de rubicon_character.gd-, nunca por
; el tipo de nota: no hay bandera en RubiconLevelNoteMetadata que lo suprima ni costura
; donde engancharse sin editar codigo del motor vendorizado. Lo mismo vale para las demas
; -`beatbox`, `blush`, `cheer`, `mom`...- que en el mod disparan animaciones de personaje
; desde sus scripts. Aqui solo se registran para que existan y la nota se dibuje y se
; pueda tocar. La animacion que cada clase deberia disparar sigue sin portear.
[gd_resource type="Resource" script_class="RubiconLevelNoteDatabase" format=3]

[ext_resource type="Script" path="res://addons/rubicon/scripts/data/game/rubicon_level_note_metadata.gd" id="1_meta"]
[ext_resource type="Script" path="res://addons/rubicon/scripts/data/game/rubicon_level_note_database.gd" id="2_db"]
[ext_resource type="PackedScene" path="res://animania_mod/notestyle/Note.tscn" id="3_note"]

[sub_resource type="Resource" id="Resource_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_Fuck_Up_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_beatbox_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_blush_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_cheer_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_erect_up_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_fresh_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_mom_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_noAnimation_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_solotime_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[sub_resource type="Resource" id="Resource_stop_bope_mania"]
script = ExtResource("1_meta")
scene = ExtResource("3_note")

[resource]
script = ExtResource("2_db")
defines = Dictionary[StringName, ExtResource("1_meta")]({
&"mania": SubResource("Resource_mania"),
&"Fuck Up_mania": SubResource("Resource_Fuck_Up_mania"),
&"beatbox_mania": SubResource("Resource_beatbox_mania"),
&"blush_mania": SubResource("Resource_blush_mania"),
&"cheer_mania": SubResource("Resource_cheer_mania"),
&"erect-up_mania": SubResource("Resource_erect_up_mania"),
&"fresh_mania": SubResource("Resource_fresh_mania"),
&"mom_mania": SubResource("Resource_mom_mania"),
&"noAnimation_mania": SubResource("Resource_noAnimation_mania"),
&"solotime_mania": SubResource("Resource_solotime_mania"),
&"stop bope_mania": SubResource("Resource_stop_bope_mania")
})
