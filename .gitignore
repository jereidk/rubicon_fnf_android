# Godot 4+ specific ignores
.godot/
/android/

# Compiled GDScript bytecode: Godot always recompiles .gd -> .gdc fresh at
# export time. A committed .gdc next to its .gd causes a duplicate ZIP
# entry ("Multiple ZIP entries with the same name") that crashes apksigner.
*.gdc
*.gdc.uid

# Linux
*.directory

# Build outputs (APK, keystore)
*.apk
*.apk.idsig
*.keystore
# Everything under builds/, not just the APK: exporting locally also leaves
# .idsig sidecars, and splitting a >30MB APK for delivery leaves part files.
# The directory is output-only, so ignoring it wholesale is the intent.
builds/
debug.keystore

# Logs
*.log

# Compiled ASTC helper (built fresh by CI, see tools/astc_compress/)
tools/astc_compress/astc_compress
.godot/astc_tmp/

# Godot writes a .uid next to every file it scans, including the pre-run
# importer outputs parked in these directories. Those are copied straight
# into .godot/imported/ by name, so their sidecars are pure churn - a local
# --import run would otherwise leave a dozen untracked files behind.
precompiled_astc_imports/*.uid
precompiled_lightmap_imports/*.uid
precompiled_texture_imports/*.uid
